    <!-- Actions -->
    <record id="action_property_owner" model="ir.actions.act_window">
        <field name="name">Property Owners</field>
        <field name="res_model">property.owner</field>
        <field name="view_mode">list,form,kanban,pivot,activity</field>
        <field name="context">{'search_default_active':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Property Owner
            </p>
            <p>
                Manage property owners, their ownership details, and associated properties.
            </p>
        </field>
    </record>
    <menuitem id="menu_property_owner" name="Property Owners" parent="property_menu"
              action="action_property_owner"
              sequence="10"/>

