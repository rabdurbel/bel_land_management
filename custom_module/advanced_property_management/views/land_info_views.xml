    <record id="view_land_info_filter" model="ir.ui.view">
        <field name="name">Land Info</field>
        <field name="model">land.info</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="thana"/>
                <field name="land_type"/>
                <field name="land_usage"/>
                <field name="deed_no"/>
                <separator/>
                <filter name="groupby_district_id" context="{'group_by' : 'district_id'}" string="District"/>
                <filter name="groupby_owner_id" context="{'group_by' : 'owner_id'}" string="Land Owner"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_land_info" model="ir.actions.act_window">
        <field name="name">Land Information</field>
        <field name="res_model">land.info</field>
        <field name="view_mode">list,form,kanban,activity,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Land record!
            </p>
        </field>
    </record>
    <menuitem id="menu_land_info" name="Land Information" parent="land_info_root_menu" action="action_land_info"
              sequence="1"/>

</odoo>