<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Property facilities action -->
    <record id="mouza_name_action" model="ir.actions.act_window">
        <field name="name">Mouza Name</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mouza.name</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Mouza Name!
            </p>
        </field>
    </record>
    <!-- Property facilities menu items -->
    <menuitem id="mouza_name_menu" name="Mouza Name" parent="property_configuration_menu"
              action="mouza_name_action" sequence="10"/>
    <!-- Property facilities tree view -->
    <record id="mouza_name_view_list" model="ir.ui.view">
        <field name="name">mouza.name.view.list</field>
        <field name="model">mouza.name</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
