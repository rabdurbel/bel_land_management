<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="loan_management_groups" model="ir.module.category">
            <field name="name">Loan Management</field>
            <field name="description">User access level for loan_management model</field>
            <field name="sequence">25</field>
        </record>
        <record id="loan_management_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="loan_management_groups"/>
        </record>
        <record id="loan_management_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="loan_management_groups"/>
            <field name="implied_ids" eval="[(4, ref('loan_management_group_user'))]"/>
        </record>
    </data>
</odoo>